<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <ThingDef ParentName="ApparelMakeableBase">
    <defName>OGF_AmethystRing</defName><label>amethyst ring</label>
    <description>A copper ring set with amethyst. Worn for its appearance, not protection.</description>
    <techLevel>Industrial</techLevel>
    <graphicData><texPath>Things/Item/Jewelry/AmethystRing</texPath><graphicClass>Graphic_Single</graphicClass></graphicData>
    <statBases><MaxHitPoints>80</MaxHitPoints><Mass>0.12</Mass><WorkToMake>1800</WorkToMake><Beauty>2</Beauty><EquipDelay>0.3</EquipDelay></statBases>
    <equippedStatOffsets><PawnBeauty>0.2</PawnBeauty></equippedStatOffsets>
    <costList><OGF_Copper>6</OGF_Copper><OGF_Amethyst>1</OGF_Amethyst></costList>
    <recipeMaker>
      <workSpeedStat>GeneralLaborSpeed</workSpeedStat><workSkill>Crafting</workSkill>
      <effectWorking>Smith</effectWorking><soundWorking>Recipe_Machining</soundWorking>
      <recipeUsers Inherit="False"><li>TableMachining</li></recipeUsers>
      <researchPrerequisite>Machining</researchPrerequisite>
      <unfinishedThingDef>UnfinishedApparel</unfinishedThingDef>
    </recipeMaker>
    <thingCategories><li>Apparel</li></thingCategories>
    <apparel>
      <bodyPartGroups><li>LeftHand</li></bodyPartGroups>
      <layers><li>Belt</li></layers>
      <countsAsClothingForNudity>false</countsAsClothingForNudity>
      <wornGraphicPath>Things/Pawn/Humanlike/Apparel/AmethystRing/AmethystRing</wornGraphicPath>
    </apparel>
  </ThingDef>
