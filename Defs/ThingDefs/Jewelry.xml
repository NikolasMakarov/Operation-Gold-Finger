<?xml version='1.0' encoding='utf-8'?>
<Defs>
  <!--Two jewelry shapes, each with amethyst or emerald. The selected Metallic stuff colors the red mask; the gem variant colors the green mask.-->
  <ThingDef ParentName="ApparelMakeableBase">
    <defName>OGF_AmethystRing</defName>
    <label>amethyst ring</label>
    <description>A metal ring set with amethyst. Its band takes the color of the chosen metal.</description>
    <techLevel>Industrial</techLevel>
    <graphicData>
      <texPath>Things/Item/Jewelry/AmethystRing</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <shaderType>CutoutComplex</shaderType>
      <colorTwo>(226,194,245)</colorTwo>
    </graphicData>
    <statBases>
      <MaxHitPoints>80</MaxHitPoints>
      <Mass>0.12</Mass>
      <WorkToMake>1800</WorkToMake>
      <Beauty>2</Beauty>
      <EquipDelay>0.3</EquipDelay>
    </statBases>
    <equippedStatOffsets>
      <PawnBeauty>0.2</PawnBeauty>
    </equippedStatOffsets>
    <costStuffCount>6</costStuffCount>
    <stuffCategories>
      <li>Metallic</li>
    </stuffCategories>
    <costList>
      <OGF_Amethyst>1</OGF_Amethyst>
    </costList>
    <recipeMaker>
      <workSpeedStat>GeneralLaborSpeed</workSpeedStat>
      <workSkill>Crafting</workSkill>
      <effectWorking>Smith</effectWorking>
      <soundWorking>Recipe_Machining</soundWorking>
      <recipeUsers Inherit="False">
        <li>TableMachining</li>
      </recipeUsers>
      <researchPrerequisite>Machining</researchPrerequisite>
      <unfinishedThingDef>UnfinishedApparel</unfinishedThingDef>
    </recipeMaker>
    <thingCategories>
      <li>Apparel</li>
    </thingCategories>
    <apparel>
      <bodyPartGroups>
        <li>LeftHand</li>
      </bodyPartGroups>
      <layers>
        <li>Belt</li>
      </layers>
      <countsAsClothingForNudity>false</countsAsClothingForNudity>
      <wornGraphicPath>Things/Pawn/Humanlike/Apparel/AmethystRing/AmethystRing</wornGraphicPath>
      <useWornGraphicMask>true</useWornGraphicMask>
    </apparel>
  </ThingDef>
