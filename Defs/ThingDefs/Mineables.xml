<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!-- These are map-generation veins, not craftable buildings. Tune commonality and lump range here. -->
  <ThingDef ParentName="RockBase">
    <defName>OGF_MineableCopper</defName><label>compacted copper</label>
    <description>Reddish copper-bearing rock. Mine it to obtain copper.</description>
    <graphicData>
      <texPath>Things/Building/Linked/RockFlecked_Atlas</texPath>
      <graphicClass>Graphic_Single</graphicClass><shaderType>CutoutComplex</shaderType>
      <color>(92,82,78)</color><colorTwo>(194,110,61)</colorTwo>
    </graphicData>
    <statBases><MaxHitPoints>1300</MaxHitPoints></statBases>
    <building>
      <isResourceRock>true</isResourceRock><veinMineable>true</veinMineable>
      <mineableThing>OGF_Copper</mineableThing><mineableYield>25</mineableYield>
      <mineableScatterCommonality>0.85</mineableScatterCommonality>
      <mineableScatterLumpSizeRange><min>5</min><max>12</max></mineableScatterLumpSizeRange>
    </building>
  </ThingDef>
